rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Reusable Authorization Functions
    // =========================================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // =========================================================================
    // 1. users Collection
    // =========================================================================
    // Authenticated users can read user docs to check names/roles.
    // Self-registration is restricted to role: "alumni".
    // Normal users cannot elevate their own role to "admin".
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId && request.resource.data.role == 'alumni';
      allow update: if (isOwner(userId) && request.resource.data.role == resource.data.role) || isAdmin();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 2. alumni Collection
    // =========================================================================
    // Public directory allows read access.
    // Alumni can create and update only their own profile document.
    // Only admin can delete alumni or manage any record.
    match /alumni/{alumniId} {
      allow read: if true;
      allow create: if (isAuthenticated() && request.auth.uid == alumniId) || isAdmin();
      allow update: if (isAuthenticated() && (request.auth.uid == alumniId || resource.data.uid == request.auth.uid)) || isAdmin();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 3. events Collection
    // =========================================================================
    // Public read access for upcoming events.
    // Only admin can create, update, or delete events.
    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // 4. jobs Collection
    // =========================================================================
    // Public read access for job listings.
    // Only admin can create, update, or delete jobs.
    match /jobs/{jobId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // 5. announcements Collection
    // =========================================================================
    // Public read access for official announcements.
    // Only admin can create, update, or delete announcements.
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // 6. achievements Collection
    // =========================================================================
    // Public read access for alumni achievements.
    // Authenticated alumni can create/update/delete ONLY their own achievements.
    // Admin can also manage achievements.
    match /achievements/{achievementId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // =========================================================================
    // 7. feedback Collection
    // =========================================================================
    // Public write (create) allowed for feedback and contact submissions.
    // Only administrators can read, query, or delete feedback entries.
    match /feedback/{feedbackId} {
      allow create: if request.resource.data.name is string && request.resource.data.email is string;
      allow read, update, delete: if isAdmin();
    }
  }
}
